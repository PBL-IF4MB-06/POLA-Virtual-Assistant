# Salin ke .env lalu isi nilai asli:
#   cp .env.example .env
#
# File .env TIDAK di-commit ke git (sudah ada di .gitignore).

# --- Supabase (wajib untuk login Google + sinkronisasi cloud) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google OAuth (wajib untuk login Google) ---
# Buat OAuth Client "Web application" di Google Cloud Console
# GOOGLE_WEB_CLIENT_ID = Client ID Web (untuk web/desktop)
# GOOGLE_SERVER_CLIENT_ID = Client ID Web yang sama (wajib untuk Android native)
# Daftarkan SHA-1 debug APK di Google Cloud → Credentials → Android client
GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# --- Backend AI ---
# Lokal: http://127.0.0.1:8787
# Hosting Render: https://pola-backend.onrender.com
POLA_BACKEND_URL=http://127.0.0.1:8787
