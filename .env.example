# Salin ke .env lalu isi nilai asli:
#   cp .env.example .env
#
# File .env TIDAK di-commit ke git (sudah ada di .gitignore).

# --- Supabase (wajib untuk login Google + sinkronisasi cloud) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google OAuth (wajib untuk login Google 100%) ---
# 1. Buat OAuth Client "Web application" di Google Cloud Console
# 2. Redirect URI: https://<PROJECT>.supabase.co/auth/v1/callback
# 3. Aktifkan Authentication → Providers → Google di Supabase (Client ID + Secret)
# 4. Jalankan: powershell -ExecutionPolicy Bypass -File scripts\setup_google_oauth.ps1
# GOOGLE_WEB_CLIENT_ID = Client ID Web
# GOOGLE_SERVER_CLIENT_ID = Client ID Web yang sama (untuk Android native idToken)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# --- Backend AI ---
# Lokal: http://127.0.0.1:8787
# Hosting Render: https://pola-backend.onrender.com
POLA_BACKEND_URL=http://127.0.0.1:8787
