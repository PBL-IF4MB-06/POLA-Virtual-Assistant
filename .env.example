# Salin ke .env lalu isi nilai asli:
#   cp .env.example .env
#
# File .env TIDAK di-commit ke git (sudah ada di .gitignore).

# --- Supabase (wajib jika pakai cloud DB) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google OAuth (opsional) ---
# GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_SERVER_CLIENT_ID=xxx.apps.googleusercontent.com

# --- Backend AI lokal (opsional, override default debug) ---
# POLA_BACKEND_URL=http://127.0.0.1:8787
