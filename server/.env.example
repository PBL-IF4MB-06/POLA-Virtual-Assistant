# Salin ke .env lalu tempel nilai asli.
# Server membaca file ini dari folder server/ (bukan dari root proyek).

# Wajib: Hugging Face token untuk Router API
# Buat token di https://huggingface.co/settings/tokens
HF_TOKEN=

# Opsional: model default di HF Router (OpenAI-compatible)
HF_MODEL=

# Port server (default 8787)
PORT=