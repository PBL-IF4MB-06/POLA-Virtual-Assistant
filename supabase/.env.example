# Salin ke .env lokal jika pakai Supabase CLI (opsional).
# Untuk Flutter, gunakan --dart-define (lihat bawah).

# Project URL dari Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (aman untuk client Flutter)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role — JANGAN masukkan ke Flutter, hanya server/backend
# SUPABASE_SERVICE_ROLE_KEY=
